<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_vindaris" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.vindaris</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Vindaris" name="vindaris_my_priorities" logo="/vindaris_my_priorities/static/description/icon.png">
                    <block title="Connection" id="vindaris_connection">
                        <setting string="Vindaris URL"
                                 help="The base URL of your Vindaris workspace.">
                            <field name="vindaris_base_url" placeholder="https://app.vindaris.com"/>
                        </setting>
                        <setting string="Status" help="Connect this Odoo to your Vindaris workspace. You only do this once.">
                            <field name="vindaris_instance_id" invisible="1"/>
                            <field name="vindaris_connected" invisible="1"/>
                            <div class="d-flex align-items-center gap-2">
                                <button name="action_vindaris_connect"
                                        type="object"
                                        string="Connect"
                                        class="btn-primary"
                                        invisible="vindaris_connected"/>
                                <span class="text-success" invisible="not vindaris_connected">Connected</span>
                                <button name="action_vindaris_disconnect"
                                        type="object"
                                        string="Disconnect"
                                        class="btn-link"
                                        invisible="not vindaris_connected"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
